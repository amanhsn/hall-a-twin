        double height = 0.14
        double radius = 0.1
        double3 xformOp:translate = (2, -0.58, 2.37)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
    def Cylinder "Fan5" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </Chiller/Looks/FanGuard>
        uniform token axis = "Z"
        double height = 0.12
        double radius = 0.5
        double3 xformOp:translate = (-2, 0.58, 2.36)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
    def Cylinder "Hub5" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </Chiller/Looks/Steel>
        uniform token axis = "Z"
        double height = 0.14
        double radius = 0.1
        double3 xformOp:translate = (-2, 0.58, 2.37)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
    def Cylinder "Fan6" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </Chiller/Looks/FanGuard>
        uniform token axis = "Z"
        double height = 0.12
        double radius = 0.5
        double3 xformOp:translate = (-0.67, 0.58, 2.36)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
    def Cylinder "Hub6" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </Chiller/Looks/Steel>
        uniform token axis = "Z"
        double height = 0.14
        double radius = 0.1
        double3 xformOp:translate = (-0.67, 0.58, 2.37)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
    def Cylinder "Fan7" (
