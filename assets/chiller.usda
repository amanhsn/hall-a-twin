        double3 xformOp:translate = (2, 0.58, 2.37)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Cylinder "FacilitySupplyStub" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </Chiller/Looks/FacilityGreen>
        uniform token axis = "X"
        double height = 0.2
        double radius = 0.11
        double3 xformOp:translate = (-2.85, -0.4, 0.35)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
    def Cylinder "FacilityReturnStub" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </Chiller/Looks/FacilityGrey>
        uniform token axis = "X"
        double height = 0.2
        double radius = 0.11
        double3 xformOp:translate = (-2.85, -0.8, 0.75)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
