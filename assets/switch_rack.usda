#usda 1.0
(
    doc = """A network rack: four 2U Spectrum-X-class switches and fibre patch panels.
    The same asset is used for leaf switches (end of each row) and spine switches (network room).
    Rack front faces -Y. Units are metres, Z is up.

    It follows the rack asset's pattern: Looks, Parts ('class' prims referenced from Front),
    and a Shell the twin tints with live data. StatusLed prims show the switch's live status."""
    defaultPrim = "Switch"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Switch" (
    kind = "component"
)
{
    custom string facility:model = "Spectrum-X SN5600-class"
    custom int facility:switchCount = 4
    custom int facility:portsPerSwitch = 64

    def Scope "Looks"
    {
        def Material "Graphite"
        {
            token outputs:surface.connect = </Switch/Looks/Graphite/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.03, 0.033, 0.037)
                float inputs:metallic = 0.35
                float inputs:roughness = 0.42
                token outputs:surface
            }
        }

        def Material "Steel"
        {
            token outputs:surface.connect = </Switch/Looks/Steel/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.32, 0.33, 0.34)
                float inputs:metallic = 0.9
                float inputs:roughness = 0.32
                token outputs:surface
            }
        }

        def Material "Vent"
        {
            token outputs:surface.connect = </Switch/Looks/Vent/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.006, 0.006, 0.007)
                float inputs:metallic = 0.2
                float inputs:roughness = 0.85
                token outputs:surface
            }
        }

        def Material "Blank"
        {
            token outputs:surface.connect = </Switch/Looks/Blank/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.018, 0.02, 0.022)
                float inputs:metallic = 0.4
                float inputs:roughness = 0.45
                token outputs:surface
            }
        }

        def Material "SwitchFace"
        {
            token outputs:surface.connect = </Switch/Looks/SwitchFace/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.16, 0.17, 0.18)
                float inputs:metallic = 0.8
                float inputs:roughness = 0.35
                token outputs:surface
            }
        }

        def Material "Ports"
        {
            token outputs:surface.connect = </Switch/Looks/Ports/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.04, 0.042, 0.045)
                float inputs:metallic = 0.1
                float inputs:roughness = 0.6
                token outputs:surface
            }
        }

        # Aqua jackets: the usual colour for multimode fibre
        def Material "Fibre"
        {
            token outputs:surface.connect = </Switch/Looks/Fibre/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.03, 0.42, 0.45)
                float inputs:metallic = 0
                float inputs:roughness = 0.55
                token outputs:surface
            }
        }

        def Material "LedGreen"
        {
            token outputs:surface.connect = </Switch/Looks/LedGreen/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0, 0, 0)
                color3f inputs:emissiveColor = (0.3, 1, 0.12)
                float inputs:metallic = 0
                float inputs:roughness = 0.5
                token outputs:surface
            }
        }
    }

    # 2U is 89 mm, 1U is 44.5 mm.
    def Scope "Parts"
    {
        class Xform "SwitchUnit" (
            doc = "One 2U switch: 64 ports of 800 Gb/s"
        )
        {
            def Cube "Face" (
                prepend apiSchemas = ["MaterialBindingAPI"]
            )
            {
                rel material:binding = </Switch/Looks/SwitchFace>
                double size = 1
                double3 xformOp:translate = (0, -0.585, 0)
                float3 xformOp:scale = (0.5, 0.03, 0.085)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
            }
            def Cube "Ports" (
                prepend apiSchemas = ["MaterialBindingAPI"]
            )
            {
                rel material:binding = </Switch/Looks/Ports>
                double size = 1
                double3 xformOp:translate = (-0.03, -0.6005, 0)
                float3 xformOp:scale = (0.4, 0.003, 0.06)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
            }
            def Cube "StatusLed" (
                prepend apiSchemas = ["MaterialBindingAPI"]
                doc = "The twin recolours StatusLed prims with the switch's live status"
            )
            {
                rel material:binding = </Switch/Looks/LedGreen>
                double size = 1
                double3 xformOp:translate = (0.21, -0.6015, 0.022)
                float3 xformOp:scale = (0.016, 0.003, 0.008)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
            }
        }

        class Xform "PatchPanel" (
            doc = "1U of fibre patch ports"
        )
        {
            def Cube "Face" (
                prepend apiSchemas = ["MaterialBindingAPI"]
            )
            {
                rel material:binding = </Switch/Looks/Blank>
                double size = 1
                double3 xformOp:translate = (0, -0.585, 0)
                float3 xformOp:scale = (0.5, 0.03, 0.0415)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
            }
            def Cube "Ports" (
                prepend apiSchemas = ["MaterialBindingAPI"]
            )
            {
                rel material:binding = </Switch/Looks/Fibre>
                double size = 1
                double3 xformOp:translate = (0, -0.6005, 0)
                float3 xformOp:scale = (0.44, 0.003, 0.018)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
            }
        }
    }

    def Xform "Shell" (
        doc = "Tinted with live data in the twin"
    )
    {
        def Cube "SideL" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            rel material:binding = </Switch/Looks/Graphite>
            double size = 1
            double3 xformOp:translate = (-0.29, 0, 1.18)
            float3 xformOp:scale = (0.02, 1.2, 2.24)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }
        def Cube "SideR" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            rel material:binding = </Switch/Looks/Graphite>
            double size = 1
            double3 xformOp:translate = (0.29, 0, 1.18)
            float3 xformOp:scale = (0.02, 1.2, 2.24)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }
        def Cube "Roof" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            rel material:binding = </Switch/Looks/Graphite>
            double size = 1
            double3 xformOp:translate = (0, 0, 2.29)
            float3 xformOp:scale = (0.6, 1.2, 0.02)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }
    }

    def Cube "Plinth" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </Switch/Looks/Vent>
        double size = 1
        double3 xformOp:translate = (0, 0, 0.05)
        float3 xformOp:scale = (0.6, 1.2, 0.1)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }
    def Cube "RailL" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </Switch/Looks/Steel>
        double size = 1
        double3 xformOp:translate = (-0.262, -0.575, 1.18)
        float3 xformOp:scale = (0.024, 0.03, 2.16)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }
    def Cube "RailR" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </Switch/Looks/Steel>
        double size = 1
        double3 xformOp:translate = (0.262, -0.575, 1.18)
        float3 xformOp:scale = (0.024, 0.03, 2.16)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }
    def Cube "Interior" (
        prepend apiSchemas = ["MaterialBindingAPI"]
        doc = "Fills the cabinet so you can't see through it"
    )
    {
        rel material:binding = </Switch/Looks/Vent>
        double size = 1
        double3 xformOp:translate = (0, -0.06, 1.18)
        float3 xformOp:scale = (0.54, 1, 2.16)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    # Fibre bundles rising from the patch panels to the overhead tray.
    def Cylinder "FibreRiserL" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </Switch/Looks/Fibre>
        uniform token axis = "Z"
        double height = 1.3
        double radius = 0.014
        double3 xformOp:translate = (-0.235, -0.616, 1.65)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
    def Cylinder "FibreRiserR" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </Switch/Looks/Fibre>
        uniform token axis = "Z"
        double height = 1.3
        double radius = 0.014
        double3 xformOp:translate = (0.235, -0.616, 1.65)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    # The front, bottom to top: blanking, then patch panels around four switches, then blanking.
    def Xform "Front"
    {
        def Cube "BlankingLow" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            rel material:binding = </Switch/Looks/Blank>
            double size = 1
            double3 xformOp:translate = (0, -0.585, 0.55)
            float3 xformOp:scale = (0.5, 0.03, 0.9)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }
        def "Patch_01" (
            prepend references = </Switch/Parts/PatchPanel>
        )
        {
            double3 xformOp:translate = (0, 0, 1.0223)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }
        def "Switch_01" (
            prepend references = </Switch/Parts/SwitchUnit>
        )
        {
            double3 xformOp:translate = (0, 0, 1.0890)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }
        def "Switch_02" (
            prepend references = </Switch/Parts/SwitchUnit>
        )
        {
            double3 xformOp:translate = (0, 0, 1.1780)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }
        def "Patch_02" (
            prepend references = </Switch/Parts/PatchPanel>
        )
        {
            double3 xformOp:translate = (0, 0, 1.2448)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }
        def "Switch_03" (
            prepend references = </Switch/Parts/SwitchUnit>
        )
        {
            double3 xformOp:translate = (0, 0, 1.3115)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }
        def "Switch_04" (
            prepend references = </Switch/Parts/SwitchUnit>
        )
        {
            double3 xformOp:translate = (0, 0, 1.4005)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }
        def "Patch_03" (
            prepend references = </Switch/Parts/PatchPanel>
        )
        {
            double3 xformOp:translate = (0, 0, 1.4673)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }
        def Cube "BlankingHigh" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            rel material:binding = </Switch/Looks/Blank>
            double size = 1
            double3 xformOp:translate = (0, -0.585, 1.845)
            float3 xformOp:scale = (0.5, 0.03, 0.71)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }
    }
}
