        )
        {
            double3 xformOp:translate = (0, 0, 1.0223)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }
        def "Compute_09" (
            prepend references = </Rack/Parts/ComputeTray>
        )
        {
            double3 xformOp:translate = (0, 0, 1.0668)
