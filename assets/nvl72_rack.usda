        }

        def Cube "Blanking" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            rel material:binding = </Rack/Looks/TrayFace>
            double size = 1
            double3 xformOp:translate = (0, -0.585, 1.9345)
            float3 xformOp:scale = (0.5, 0.03, 0.531)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }
        def "Mgmt_Switch" (
            prepend references = </Rack/Parts/SwitchTray>
        )
        {
            double3 xformOp:translate = (0, 0, 2.2237)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }
    }

    variantSet "cooling" =
    {
        "liquid"
        {
            # Direct-to-chip liquid cooling: cold plates on every GPU,
            # coolant manifolds down the back, hoses up to the overhead headers.
            custom token facility:cooling = "liquid"
            custom float facility:maxPowerKW = 132
            custom float facility:liquidFraction = 0.85

            def Cube "SupplyManifold" (
                prepend apiSchemas = ["MaterialBindingAPI"]
            )
            {
                rel material:binding = </Rack/Looks/CoolantBlue>
                double size = 1
                double3 xformOp:translate = (0.2, 0.48, 1.18)
                float3 xformOp:scale = (0.05, 0.04, 2)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
            }
            def Cube "ReturnManifold" (
                prepend apiSchemas = ["MaterialBindingAPI"]
            )
            {
                rel material:binding = </Rack/Looks/CoolantRed>
                double size = 1
                double3 xformOp:translate = (-0.2, 0.54, 1.18)
                float3 xformOp:scale = (0.05, 0.04, 2)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
            }
            def Cylinder "SupplyHose" (
                prepend apiSchemas = ["MaterialBindingAPI"]
                doc = "Rises to the supply header at 2.48 m"
            )
            {
                rel material:binding = </Rack/Looks/CoolantBlue>
                uniform token axis = "Z"
                double height = 0.3
                double radius = 0.02
                double3 xformOp:translate = (0.2, 0.48, 2.33)
                uniform token[] xformOpOrder = ["xformOp:translate"]
            }
            def Cylinder "ReturnHose" (
                prepend apiSchemas = ["MaterialBindingAPI"]
                doc = "Rises to the return header at 2.62 m"
            )
            {
                rel material:binding = </Rack/Looks/CoolantRed>
                uniform token axis = "Z"
                double height = 0.44
                double radius = 0.02
                double3 xformOp:translate = (-0.2, 0.54, 2.4)
                uniform token[] xformOpOrder = ["xformOp:translate"]
            }
        }
        "air"
        {
            # Air cooling tops out around 40 kW per rack,
            # which is why NVL72-class racks need liquid.
            custom token facility:cooling = "air"
            custom float facility:maxPowerKW = 40
            custom float facility:liquidFraction = 0

            # A variant can add children to prims defined outside it, like the Shell.
            over "Shell"
            {
                def Cube "RearDoor" (
                    prepend apiSchemas = ["MaterialBindingAPI"]
                )
                {
                    rel material:binding = </Rack/Looks/Graphite>
                    double size = 1
                    double3 xformOp:translate = (0, 0.595, 1.18)
                    float3 xformOp:scale = (0.58, 0.01, 2.2)
                    uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
                }
            }

            def Cylinder "Fan1" (
                prepend apiSchemas = ["MaterialBindingAPI"]
            )
            {
                rel material:binding = </Rack/Looks/Vent>
                uniform token axis = "Y"
                double height = 0.015
                double radius = 0.24
                double3 xformOp:translate = (0, 0.607, 0.55)
                uniform token[] xformOpOrder = ["xformOp:translate"]
            }
            def Cylinder "Hub1" (
                prepend apiSchemas = ["MaterialBindingAPI"]
            )
            {
                rel material:binding = </Rack/Looks/Steel>
                uniform token axis = "Y"
                double height = 0.012
                double radius = 0.06
                double3 xformOp:translate = (0, 0.612, 0.55)
                uniform token[] xformOpOrder = ["xformOp:translate"]
            }
            def Cylinder "Fan2" (
                prepend apiSchemas = ["MaterialBindingAPI"]
            )
            {
                rel material:binding = </Rack/Looks/Vent>
                uniform token axis = "Y"
                double height = 0.015
                double radius = 0.24
                double3 xformOp:translate = (0, 0.607, 1.18)
                uniform token[] xformOpOrder = ["xformOp:translate"]
            }
            def Cylinder "Hub2" (
                prepend apiSchemas = ["MaterialBindingAPI"]
            )
            {
                rel material:binding = </Rack/Looks/Steel>
                uniform token axis = "Y"
                double height = 0.012
                double radius = 0.06
                double3 xformOp:translate = (0, 0.612, 1.18)
                uniform token[] xformOpOrder = ["xformOp:translate"]
            }
            def Cylinder "Fan3" (
                prepend apiSchemas = ["MaterialBindingAPI"]
            )
            {
                rel material:binding = </Rack/Looks/Vent>
                uniform token axis = "Y"
                double height = 0.015
                double radius = 0.24
                double3 xformOp:translate = (0, 0.607, 1.81)
                uniform token[] xformOpOrder = ["xformOp:translate"]
            }
            def Cylinder "Hub3" (
                prepend apiSchemas = ["MaterialBindingAPI"]
            )
            {
                rel material:binding = </Rack/Looks/Steel>
