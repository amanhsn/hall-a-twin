#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "World" (
    kind = "assembly"
)
{
    custom float facility:itLoadKW = 7830
    custom int facility:jobRacks = 80
    custom float facility:jobSpeedPct = 100
    custom float facility:pue = 1.22

    def Scope "Looks"
    {
        def Material "Concrete"
        {
            token outputs:surface.connect = </World/Looks/Concrete/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.032, 0.034, 0.036)
                float inputs:metallic = 0
                float inputs:roughness = 0.85
                token outputs:surface
            }
        }

        def Material "Yard"
