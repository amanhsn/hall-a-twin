        }
        def "Compute_18" (
            prepend references = </Rack/Parts/ComputeTray>
        )
        {
            double3 xformOp:translate = (0, 0, 1.4672)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }
        def "Power_05" (
            prepend references = </Rack/Parts/PowerShelf>
        )
        {
            double3 xformOp:translate = (0, 0, 1.5117)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }
        def "Power_06" (
            prepend references = </Rack/Parts/PowerShelf>
        )
        {
            double3 xformOp:translate = (0, 0, 1.5563)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }
        def "Power_07" (
